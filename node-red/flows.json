rue,"useThemeColors":true,"passthru":false,"options":[{"label":"Auto","icon":"","value":"auto","valueType":"str","color":"#999999"},{"label":"Inlet","icon":"","value":"inlet","valueType":"str","color":"#ff6666"},{"label":"Pump","icon":"","value":"pump","valueType":"str","color":"#ff6666"}],"topic":"payload","topicType":"msg","x":230,"y":420,"wires":[["9c0717e4d46a74ca"]]},{"id":"9c0717e4d46a74ca","type":"change","z":"f6f2187d.f17ca8","name":"Update mode","rules":[{"t":"set","p":"mode","pt":"global","to":"payload","tot":"msg"}],"action":"","property":"","from":"","to":"","reg":false,"x":420,"y":420,"wires":[["1219f429f04af953"]]},{"id":"1219f429f04af953","type":"debug","z":"f6f2187d.f17ca8","name":"debug 1","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":600,"y":420,"wires":[]},{"id":"c148de6fdea69f9c","type":"function","z":"f6f2187d.f17ca8","name":"main logic for valves","func":"const l = msg.payload.level;\n\nconst isFull = msg.payload.full\n\n// first output is inlet valve\n// second output is bottom tank valve\nlet now = new Date();\nglobal.set(\"top-timestamp\", now.toISOString());\n\n\nif (isFull === true) {\n    node.warn(\"Tank is full by switch, turn all off\")\n    return [{ payload: \"OFF\" }, { payload: \"OFF\" }]; // just turn all off\n\n} else if (l < 8) {\n    node.warn(\"Tank is full by level, turn all off\");\n    return [{ payload: \"OFF\" }, { payload: \"OFF\" }]; // just turn all off\n\n} else if (l > 20) {\n    node.warn(\"Tank not full\");\n\n} else {\n    node.warn(\"Not full not empty\");\n    return;\n}\n\n\n// here we come if top tank is not full\nconst mode = global.get(\"mode\") ?? \"inlet\";\nconst low_tank_level = global.get(\"low_tank_level\") ?? -1;\nconst low_tank_full = low_tank_level > 0 && low_tank_level <= 25;\n\nif (mode == \"auto\") {\n    const hours = now.getHours();\n    if (hours >= 9 && hours <= 12) {\n        // pump mode\n        node.warn(\"Auto: pump mode, low tank level (\" + low_tank_level + \") is full \" + low_tank_full);\n        if (low_tank_full) {\n            return [{ payload: \"OFF\" }, { payload: \"ON\" }];\n        }\n    } else {\n        // inlet mode\n        node.warn(\"Auto: inlet mode\");\n        return [{ payload: \"ON\" }, { payload: \"OFF\" }];\n    }\n} else if (mode === \"pump\") {\n    node.warn(\"Auto: pump mode, low tank level (\" + low_tank_level + \") is full \" + low_tank_full);\n    if (low_tank_full) {\n        return [{ payload: \"OFF\" }, { payload: \"ON\" }];\n    }\n} else if (mode === \"inlet\") {\n    return [{ payload: \"ON\" }, { payload: \"OFF\" }]\n} else {\n    node.error(\"Unknown mode! \" + mode);\n    return [{ payload: \"OFF\" }, { payload: \"OFF\" }]\n}\n\n\n","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":560,"y":960,"wires":[["8ad10e935f27f22d","3d38c87b5d2e5caf"],["bd86489f46f229de","655e2de28c347c32"]]},{"id":"d3770ceaf48a560c","type":"change","z":"f6f2187d.f17ca8","name":"OFF","rules":[{"t":"set","p":"payload","pt":"msg","to":"OFF","tot":"str"}],"action":"","property":"","from":"","to":"","reg":false,"x":970,"y":840,"wires":[["3d38c87b5d2e5caf"]]},{"id":"3d38c87b5d2e5caf","type":"mqtt out","z":"f6f2187d.f17ca8","name":"inlet valve","topic":"cmnd/pump-valve-unit/valve","qos":"1","retain":"false","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"07229715defc3654","x":1340,"y":820,"wires":[]},{"id":"f96edd7d7a2fcbba","type":"inject","z":"f6f2187d.f17ca8","name":"","props":[{"p":"payload"}],"repeat":"5","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":250,"y":500,"wires":[["6b72ac07028d7161","a5e878badd605c7c"]]},{"id":"6b72ac07028d7161","type":"function","z":"f6f2187d.f17ca8","name":"top tank missing msg","func":"let startTime = new Date(global.get(\"top-timestamp\")); // e.g., \"2026-07-16T12:00:00Z\"\nlet endTime = new Date();                // Current t